# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment files
.env
.env.*
app/.env
!.env.example
!app/env/.env.example

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Local databases and logs
*.db
*.sqlite3
*.log

# Runtime and uploaded/generated app data
uploads/*
!uploads/.gitkeep

# IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
