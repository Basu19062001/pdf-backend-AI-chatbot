# Application Settings
PROJECT_NAME= "PDF Chatbot Backend"
VERSION= "0.1.0"
ENVIRONMENT= "development"
DEBUG= "true"
LOG_LEVEL= "INFO"
API_V1_STR= "/api/v1"

# Database Configuration
DB_SCHEME= "postgresql+asyncpg"
DB_USERNAME= "admin"
DB_PASSWORD= "password"
DB_HOST= "localhost"
DB_PORT= "5432"
DB_NAME= "pdf_chatbot_db"
DB_ECHO= "false"
DB_POOL_SIZE= "10"
DB_MAX_OVERFLOW= "20"

# JWT Authentication
JWT_SECRET_KEY= "change-me-in-production-at-least-32chars"
JWT_ALGORITHM= "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES= "60"
JWT_REFRESH_TOKEN_EXPIRE_DAYS= "7"

# API Documentation
DOCS_ENABLED= "true"
DOC_ROOT_USERNAME= "admin"
DOC_ROOT_PASSWORD= "docs-password"

# Redis Cache
REDIS_ENABLED= "true"
REDIS_HOST= "localhost"
REDIS_PORT= "6379"
REDIS_PASSWORD= ""
REDIS_DB= "0"

# Google OAuth
GOOGLE_CLIENT_ID= ""
GOOGLE_CLIENT_SECRET= ""
GOOGLE_REDIRECT_URI= ""
FRONTEND_AUTH_SUCCESS_URL= "http://localhost:5173/auth/google/success"
FRONTEND_AUTH_ERROR_URL= "http://localhost:5173/login"

# OpenAI Configuration
OPENAI_API_KEY= ""
EMBEDDING_MODEL= "text-embedding-3-small"
CHAT_MODEL= "gpt-4o"

# Pinecone Vector Database
PINECONE_API_KEY= ""
PINECONE_INDEX_NAME= ""
PINECONE_INDEX_HOST= ""

# Document Settings
DOCUMENT_UPLOAD_DIR= "uploads"
DOCUMENT_MAX_FILE_SIZE_BYTES= "10485760"
DOCUMENT_CHUNK_SIZE= "1200"
DOCUMENT_CHUNK_OVERLAP= "200"
