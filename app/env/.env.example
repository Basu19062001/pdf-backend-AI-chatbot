PROJECT_NAME= "PDF Chatbot API"
PROJECT_DESCRIPTION= "A FastAPI application that allows users to upload PDF documents and interact with them using OpenAI's language models. The application provides endpoints for uploading PDFs, asking questions about the content, and retrieving answers based on the uploaded documents."
PROJECT_VERSION= "1.0.0"
VERSION= "1.0.0"
ENVIRONMENT= "development"
DEBUG= "true"
LOG_LEVEL= "INFO"

API_V1_STR= "/api/v1"

DB_SCHEME= "postgresql+asyncpg"
DB_USERNAME= "postgres"
DB_PASSWORD= "postgres"
DB_HOST= "localhost"
DB_PORT= "5432"
DB_NAME= "pdf_chatbot"
DB_ECHO= "false"
DB_POOL_SIZE= "10"
DB_MAX_OVERFLOW= "20"
DB_POOL_TIMEOUT= "30"
DB_POOL_RECYCLE= "1800"
DB_POOL_PRE_PING= "true"
DB_CONNECT_TIMEOUT= "10"

DOCS_ENABLED= "true"
DOC_ROOT_USERNAME= "admin"
DOC_ROOT_PASSWORD= "docs-password"

JWT_SECRET_KEY= "change-this-to-a-long-random-secret-key"
JWT_ALGORITHM= "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES= "60"
JWT_ISSUER= "pdf-chatbot-backend"
JWT_AUDIENCE= "pdf-chatbot-clients"

REDIS_ENABLED= "true"
REDIS_SCHEME= "redis"
REDIS_HOST= "redis-stack"
REDIS_PORT= "6379"
REDIS_PASSWORD= ""
REDIS_DB= "0"
REDIS_CONNECT_TIMEOUT= "5"
REDIS_TOKEN_KEY_PREFIX= "auth:access"

OPENAI_API_KEY= ""
OPENAI_EMBEDDING_TIMEOUT_SECONDS= "30"
EMBEDDING_MODEL= "text-embedding-3-small"
EMBEDDING_DIMENSION= "1536"
EMBEDDING_BATCH_SIZE= "100"
OPENAI_CHAT_MODEL= "gpt-4.1-mini"
OPENAI_CHAT_TIMEOUT_SECONDS= "45"
OPENAI_CHAT_MAX_COMPLETION_TOKENS= "800"
OPENAI_CHAT_TEMPERATURE= "0.2"
OPENAI_CHAT_INPUT_COST_PER_1M_TOKENS= "0"
OPENAI_CHAT_OUTPUT_COST_PER_1M_TOKENS= "0"
CHAT_RETRIEVAL_TOP_K= "6"
CHAT_HISTORY_MESSAGE_LIMIT= "8"
CHAT_MAX_CONTEXT_CHARACTERS= "12000"
CHAT_SOURCE_TEXT_MAX_CHARACTERS= "500"
CHAT_SYSTEM_PROMPT= "You are a document-grounded assistant. Answer using only the supplied document context and recent conversation history. If the context is insufficient, say so clearly and do not fabricate facts."

PINECONE_API_KEY= ""
PINECONE_INDEX_NAME= ""
PINECONE_INDEX_HOST= ""
PINECONE_CLOUD= "aws"
PINECONE_REGION= "us-east-1"
PINECONE_NAMESPACE= ""
